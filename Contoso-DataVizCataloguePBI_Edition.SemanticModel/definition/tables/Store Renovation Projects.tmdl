		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\michael.hewitt\OneDrive - Michael Hewitt\YouTube\ContosoDataVizCSVs\Store Renovation Projects.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"ProjectID", Int64.Type}, {"StoreKey", Int64.Type}, {"CountryName", type text}, {"State", type text}, {"TaskName", type text}, {"StartDate", type date}, {"EndDate", type date}, {"PercentComplete", Int64.Type}, {"PredecessorProjectID", Int64.Type}})
				in
				  #"Changed column type"

	annotation PBI_NavigationStepName = Navigation

