	partition Store = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\michael.hewitt\OneDrive - Michael Hewitt\Talks\Contoso csv-1m\store.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"StoreKey", Int64.Type}, {"StoreCode", Int64.Type}, {"GeoAreaKey", Int64.Type}, {"CountryCode", type text}, {"CountryName", type text}, {"State", type text}, {"OpenDate", type date}, {"CloseDate", type date}, {"Description", type text}, {"SquareMeters", Int64.Type}, {"Status", type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"CountryCode", "Country Code"}, {"CountryName", "Country Name"}, {"OpenDate", "Open Date"}, {"CloseDate", "Close Date"}, {"SquareMeters", "Square Meters"}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Renamed Columns", "Continent", each if [Country Name] = "Australia" then "Australia" else if [Country Name] = "Canada" then "North America" else if [Country Name] = "France" then "Europe" else if [Country Name] = "Germany" then "Europe" else if [Country Name] = "Italy" then "Europe" else if [Country Name] = "Netherlands" then "Europe" else if [Country Name] = "United States" then "North America" else if [Country Name] = "United Kingdom" then "Europe" else if [Country Name] = "Online" then "Online" else null, type text),
				    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "Channel", each if [Country Name] = "Online" then "Online" else "In Store", type text)
				in
				    #"Added Conditional Column1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

