/// Store dimension containing physical and online retail locations, including geography, size, and lifecycle status.
table Store
	lineageTag: 2329c626-cbca-4b7d-b11a-403bc761f99d

	/// Surrogate key uniquely identifying each store; used to relate Sales and Store Renovation Projects to Store. Hidden.
	column StoreKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9d0938df-a6f9-4db1-8548-8bd827c8fea6
		summarizeBy: none
		sourceColumn: StoreKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Business code identifying the store.
	column StoreCode
		dataType: int64
		formatString: 0
		lineageTag: 5d18caad-0649-4cff-9000-3ac6f5dea19a
		summarizeBy: none
		sourceColumn: StoreCode

		annotation SummarizationSetBy = User

	/// Internal geographic grouping key used during data preparation; not intended for reporting. Hidden.
	column GeoAreaKey
