/// Standard calendar date dimension used for time intelligence across all fact and derived tables.
table Date
	lineageTag: c4a5f42a-c75f-4e45-99ef-b46e22f86273
	dataCategory: Time

	/// Calendar date; the primary key of the Date table and the marked date-table key column.
	column Date
		dataType: dateTime
		isKey
		formatString: mm/dd/yyyy
		lineageTag: 88677617-4118-4993-a4f2-07e8f1b02032
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Integer-encoded surrogate key for Date (yyyymmdd); hidden, used internally for joins.
	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7faa80c1-7b5d-418c-8b3d-6aa1b48bceec
		summarizeBy: none
		sourceColumn: DateKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	/// Calendar year of the date.
	column Year
