	/// Calendar drill-down path: Year > Quarter > Month.
	hierarchy 'Date Hierarchy'
		lineageTag: c25e3a73-9eb3-4002-afa4-153de5974d32

		level Year
			lineageTag: 7b6f16cf-9685-4062-9591-da46b457fb6b
