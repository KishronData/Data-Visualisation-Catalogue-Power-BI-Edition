		level Month
			lineageTag: fe7fecfa-2fdb-4ea2-a313-0e40c12b5608
			column: Month

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\michael.hewitt\OneDrive - Michael Hewitt\Talks\Contoso csv-1m\date.csv"),[Delimiter=",", Columns=17, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Date", type date}, {"DateKey", Int64.Type}, {"Year", Int64.Type}, {"YearQuarter", type text}, {"YearQuarterNumber", Int64.Type}, {"Quarter", type text}, {"YearMonth", type text}, {"YearMonthShort", type text}, {"YearMonthNumber", Int64.Type}, {"Month", type text}, {"MonthShort", type text}, {"MonthNumber", Int64.Type}, {"DayofWeek", type text}, {"DayofWeekShort", type text}, {"DayofWeekNumber", Int64.Type}, {"WorkingDay", Int64.Type}, {"WorkingDayNumber", Int64.Type}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"YearQuarter", "Year Quarter"}, {"YearQuarterNumber", "Year Quarter Number"}, {"YearMonth", "Year Month"}, {"YearMonthShort", "Year Month Short"}, {"YearMonthNumber", "Year Month Number"}, {"MonthShort", "Month Short"}, {"MonthNumber", "Month Number"}, {"DayofWeek", "Day of Week"}, {"DayofWeekShort", "Day of Week Short"}, {"DayofWeekNumber", "Day of Week Number"}, {"WorkingDay", "Working Day"}, {"WorkingDayNumber", "Working Day Number"}}),
				    LastSalesDate = List.Max(Sales[OrderDate]),
				    #"Filtered to Sales Range" = Table.SelectRows(#"Renamed Columns", each [Date] <= LastSalesDate),
				    #"Added Conditional Column" = Table.AddColumn(#"Filtered to Sales Range", "Era", each if [Year] >= 2015 and [Year] <= 2017 then "2015-2017" else if [Year] >= 2018 and [Year] <= 2020 then "2018-2020" else if [Year] >= 2021 and [Year] <= 2023 then "2021-2023" else null, type text)
				in
				    #"Added Conditional Column"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

